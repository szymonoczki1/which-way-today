# Backend
DATABASE_URL=sqlite:///./whichway.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini. Any failure falls back to rule-based advice.
OPENAI_MODEL=

# Frontend
VITE_API_URL=http://localhost:8000

# Docker (docker compose only; both optional). Compose derives the frontend's API
# URL and the backend's CORS origins from these, and ignores VITE_API_URL /
# CORS_ORIGINS / DATABASE_URL above. Works when the browser runs on the Docker
# host (localhost); serving to other machines needs those two values changed.
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
